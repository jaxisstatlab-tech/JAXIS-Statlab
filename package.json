{
  "name": "JAXIS StatLab",
  "private": true,
  "scripts": {
    "build": "turbo run build --concurrency=2",
    "build:web": "turbo run build --filter=web",
    "build:app": "turbo run build --filter=app",
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/clean-processes.ps1 && turbo run dev --concurrency=3",
    "dev:web": "powershell -ExecutionPolicy Bypass -File scripts/clean-processes.ps1 && turbo run dev --filter=web",
    "dev:app": "powershell -ExecutionPolicy Bypass -File scripts/clean-processes.ps1 && turbo run dev --filter=app",
    "dev:offline": "npm run dev:offline --workspace=app",
    "dev/offline": "npm run dev:offline --workspace=app",
    "offline": "npm run dev:offline --workspace=app",
    "dev:localdb": "npm run dev:localdb --workspace=app --",
    "clean": "powershell -ExecutionPolicy Bypass -File scripts/clean-processes.ps1",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.6",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
